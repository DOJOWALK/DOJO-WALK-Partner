rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // COMMON HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function adminPath() {
      return /databases/$(database)/documents/admin_users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.get('isActive', false) == true
        && get(adminPath()).data.get('role', '') == 'super_admin';
    }

    function validString(data, field) {
      return field in data && data[field] is string;
    }

    function validOptionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function validTimestamp(data, field) {
      return field in data && data[field] is timestamp;
    }

    function validOptionalTimestamp(data, field) {
      return !(field in data)
        || data[field] is timestamp
        || data[field] == null;
    }

    // =====================================================
    // ADMIN USERS
    // =====================================================

    match /admin_users/{adminUid} {

      allow get: if isOwner(adminUid) || isAdmin();

      allow list: if isAdmin();

      // Admin accounts must be provisioned securely.
      allow create, delete: if false;

      // Only an existing active super admin can edit
      // admin records.
      allow update: if isAdmin()
        && request.resource.data.get('role', '')
          in ['super_admin', 'admin', 'support'];
    }

    // =====================================================
    // WALKER / PARTNER PROFILES
    // Path: walkers/{walkerUid}
    // =====================================================

    match /walkers/{walkerUid} {

      // Walker can read own profile.
      // Admin can read all profiles.
      // Other signed-in users can read approved,
      // active walker profiles.
      allow get: if isOwner(walkerUid)
        || isAdmin()
        || (
          signedIn()
          && resource.data.get('isActive', false) == true
          && resource.data.get('isApproved', false) == true
        );

      allow list: if isAdmin();

      // Initial registration.
      allow create: if isOwner(walkerUid)
        && request.resource.data.keys().hasOnly([
          'userId',
          'fullName',
          'phone',
          'dateOfBirth',
          'email',
          'gender',
          'updatedAt',
          'createdAt',
          'status',
          'isActive',
          'isApproved',
          'verificationStatus'
        ])
        && request.resource.data.get('userId', '') == request.auth.uid
        && validString(request.resource.data, 'fullName')
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 80
        && validString(request.resource.data, 'phone')
        && validTimestamp(request.resource.data, 'dateOfBirth')
        && validTimestamp(request.resource.data, 'createdAt')
        && validTimestamp(request.resource.data, 'updatedAt')
        && request.resource.data.get('status', '') == 'under_review'
        && request.resource.data.get('isActive', true) == false
        && request.resource.data.get('isApproved', true) == false
        && request.resource.data.get('verificationStatus', '') == 'pending'
        && validOptionalString(request.resource.data, 'email')
        && validOptionalString(request.resource.data, 'gender');

      // Walker can update personal details and permitted
      // profile/KYC fields, but cannot change approval flags.
      allow update: if isOwner(walkerUid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'userId',
            'fullName',
            'phone',
            'dateOfBirth',
            'email',
            'gender',
            'photoUrl',
            'profileImage',
            'address',
            'city',
            'area',
            'zones',
            'documents',
            'kyc',
            'availability',
            'updatedAt',
            'fcmToken',
            'deviceTokens',
            'bankDetails',
            'emergencyContact'
          ])
        && request.resource.data.get('userId', '') == request.auth.uid
        && validString(request.resource.data, 'fullName')
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 80
        && validString(request.resource.data, 'phone')
        && validTimestamp(request.resource.data, 'dateOfBirth')
        && validTimestamp(request.resource.data, 'updatedAt')
        && validOptionalString(request.resource.data, 'email')
        && validOptionalString(request.resource.data, 'gender');

      // Admin alone can approve, reject, suspend or deactivate
      // a walker. Admin must update the existing document.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'walkerId',
            'status',
            'isActive',
            'isApproved',
            'verificationStatus',
            'updatedAt'
          ])
        && request.resource.data.get('status', '')
          in [
            'under_review',
            'approved',
            'rejected',
            'suspended',
            'inactive'
          ]
        && request.resource.data.get('verificationStatus', '')
          in ['pending', 'verified', 'rejected']
        && request.resource.data.get('isActive', false) is bool
        && request.resource.data.get('isApproved', false) is bool;

      allow delete: if false;
    }

    // =====================================================
    // WALKER PRIVATE SUBCOLLECTIONS
    // =====================================================

    match /walkers/{walkerUid}/{subcollection}/{documentId} {

      // Walker may read documents inside their own profile.
      // Admin may read for verification.
      allow read: if isOwner(walkerUid) || isAdmin();

      // Private KYC/profile documents may be submitted by
      // the owner. These writes do not grant approval.
      allow create, update: if isOwner(walkerUid)
        && subcollection in [
          'documents',
          'kyc',
          'availability',
          'notifications',
          'device_tokens'
        ];

      allow delete: if isAdmin();
    }

    // =====================================================
    // CUSTOMER USER PROFILES
    // =====================================================

    match /users/{userId} {

      allow get: if isOwner(userId) || isAdmin();

      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'phoneNumber',
          'email',
          'role',
          'dateOfBirth',
          'dob',
          'age',
          'photoUrl',
          'profileImage',
          'createdAt',
          'updatedAt',
          'language',
          'notificationEnabled'
        ])
        && request.resource.data.get('role', 'customer') == 'customer';

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'email',
            'dateOfBirth',
            'dob',
            'age',
            'photoUrl',
            'profileImage',
            'updatedAt',
            'language',
            'notificationEnabled'
          ])
        && request.resource.data.get('role', 'customer') == 'customer';

      allow delete: if false;

      // ===================================================
      // CUSTOMER PETS
      // ===================================================

      match /pets/{petId} {

        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'name',
            'gender',
            'age',
            'breed',
            'size',
            'behaviour',
            'specialCare',
            'notes',
            'createdAt',
            'updatedAt',
            'dob',
            'weight',
            'photoUrl'
          ])
          && validString(request.resource.data, 'name')
          && validString(request.resource.data, 'breed')
          && validTimestamp(request.resource.data, 'createdAt')
          && validTimestamp(request.resource.data, 'updatedAt');

        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'gender',
              'age',
              'breed',
              'size',
              'behaviour',
              'specialCare',
              'notes',
              'updatedAt',
              'dob',
              'weight',
              'photoUrl'
            ])
          && validTimestamp(request.resource.data, 'updatedAt');

        allow delete: if isOwner(userId) || isAdmin();
      }

      // ===================================================
      // CUSTOMER ADDRESSES
      // ===================================================

      match /addresses/{addressId} {

        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'label',
            'flatHouse',
            'buildingSociety',
            'area',
            'landmark',
            'city',
            'pincode',
            'pickupInstructions',
            'latitude',
            'longitude',
            'isDefault',
            'createdAt',
            'updatedAt'
          ])
          && validString(request.resource.data, 'label')
          && validString(request.resource.data, 'area')
          && validString(request.resource.data, 'city')
          && validString(request.resource.data, 'pincode')
          && validTimestamp(request.resource.data, 'createdAt')
          && validTimestamp(request.resource.data, 'updatedAt');

        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'label',
              'flatHouse',
              'buildingSociety',
              'area',
              'landmark',
              'city',
              'pincode',
              'pickupInstructions',
              'latitude',
              'longitude',
              'isDefault',
              'updatedAt'
            ])
          && validTimestamp(request.resource.data, 'updatedAt');

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // =====================================================
    // BOOKINGS
    // =====================================================

    match /bookings/{bookingId} {

      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.get('customerId', '') == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.get('walkerId', '') == request.auth.uid
        );

      // Customer booking creation should be validated by
      // the complete shared production rules before deployment.
      allow create: if false;

      // Customer may request cancellation without changing
      // booking assignment or approval fields.
      allow update: if signedIn()
        && resource.data.get('customerId', '') == request.auth.uid
        && resource.data.get('status', '') in [
          'pending',
          'confirmed',
          'assigned'
        ]
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'cancelRequest',
            'updatedAt'
          ]);

      // Assigned walker can update walk progress only.
      allow update: if signedIn()
        && resource.data.get('walkerId', '') == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt',
            'walkSchedules',
            'walkNotes',
            'peeCount',
            'poopCount',
            'distance',
            'durationActual'
          ]);

      // Admin can manage bookings.
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // WALK REQUESTS
    // =====================================================

    match /walk_requests/{requestId} {
      allow read, write: if false;
    }

    // =====================================================
    // WALKER REVIEWS
    // =====================================================

    match /walker_reviews/{reviewId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.get('customerId', '') == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.get('customerId', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'customerId',
          'walkerId',
          'rating',
          'review',
          'createdAt'
        ])
        && request.resource.data.get('rating', 0) is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && validTimestamp(request.resource.data, 'createdAt');

      allow update, delete: if isAdmin();
    }

    // =====================================================
    // ZONES
    // =====================================================

    match /zones/{zoneId} {

      allow get, list: if true;

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // CUSTOMERS ADMIN COLLECTION
    // =====================================================

    match /customers/{customerId} {

      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.get('uid', '') == request.auth.uid
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // COUPONS
    // =====================================================

    match /coupons/{couponId} {

      allow get, list: if resource.data.get('isActive', false) == true
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // PAYMENTS
    // =====================================================

    match /payments/{paymentId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.get('customerId', '') == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // AUDIT LOGS
    // =====================================================

    match /audit_logs/{logId} {

      allow read: if isAdmin();

      // Client apps cannot write audit logs directly.
      allow create, update, delete: if false;
    }

    // =====================================================
    // DEFAULT DENY
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
